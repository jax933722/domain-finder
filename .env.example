# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Company Domain Enrichment

# --- Observability ---
# LOG_FORMAT: "text" (human-readable) or "json" (structured, for aggregators).
LOG_FORMAT=text
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100

# --- Scale tuning ---
DB_INSERT_BATCH=500
PROVIDER_RATE_LIMIT_PER_SEC=8
TASK_TIME_LIMIT=21600
TASK_SOFT_TIME_LIMIT=21540

# --- Security (generate with: openssl rand -hex 32) ---
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin user, created automatically on startup.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:8080

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=domainfinder

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Domain cache TTL (seconds). Default 30 days. ---
DOMAIN_CACHE_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Search providers. Configure at least one for real domain discovery.
# Wikipedia/Wikidata works with no key and is always available as a fallback.
# ---------------------------------------------------------------------------
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
BING_SEARCH_API_KEY=

# Self-hosted SearXNG meta-search — NO API KEY NEEDED. docker-compose starts a
# searxng service and sets this automatically. Aggregates Google/Bing/DuckDuckGo.
SEARXNG_URL=http://searxng:8080

# Ordered provider preference (comma-separated). searxng + wikipedia are keyless.
SEARCH_PROVIDER_ORDER=brave,google,bing,searxng,wikipedia

# ---------------------------------------------------------------------------
# Optional self-hosted LLM re-ranker (Ollama). Improves accuracy on ambiguous
# cases by choosing among REAL search results — it never invents a domain.
# Start it with:  docker compose --profile llm up -d ollama
# Pull a model:   docker compose exec ollama ollama pull llama3.1
# Then set LLM_ENABLED=true and restart backend + worker.
# ---------------------------------------------------------------------------
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1

# --- Discovery tuning ---
CONFIDENCE_THRESHOLD=0.6
JOB_CONCURRENCY=10
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RETRIES=3

# --- Live reachability confirmation ---
# After a domain is found, confirm it actually responds (and follow redirects).
# Never invents a domain; only validates one already identified.
VERIFY_DOMAIN_REACHABLE=true
REACHABILITY_TIMEOUT_SECONDS=6
REACHABILITY_PENALTY=0.3

# --- Frontend build-time API base (used by docker-compose frontend build) ---
VITE_API_BASE_URL=/api/v1
